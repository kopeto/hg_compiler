Language: Cpp
BasedOnStyle: LLVM

# Indentation
IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4

# Brace style – keep opening brace on same line as declaration
BreakBeforeBraces: Attach

# Align consecutive declarations so type and name line up in the same block
AlignConsecutiveDeclarations:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false

# Align consecutive assignments (int x = 1; float y = 2.0;)
AlignConsecutiveAssignments:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false

# Pointer / reference bind to the type (int* p, not int *p)
PointerAlignment: Left

# Column limit (0 = no wrapping)
ColumnLimit: 120

# Include sorting
SortIncludes: CaseSensitive
IncludeBlocks: Regroup

# Spaces
SpaceBeforeParens: ControlStatements
SpaceInEmptyParentheses: false
SpaceAfterCStyleCast: false
SpaceBeforeAssignmentOperators: true

# Short functions / lambdas on one line
AllowShortFunctionsOnASingleLine: Inline
AllowShortLambdasOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never

# Constructor initialiser list
BreakConstructorInitializers: BeforeColon
ConstructorInitializerIndentWidth: 4

# Trailing comma in enums
